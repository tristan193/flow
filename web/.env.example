# Flow App environment (copy to .env.local for development)

# Required — random string, 32+ characters
FLOW_SESSION_SECRET=

# Required — one passcode per partner
FLOW_PASSCODE_TRISTAN=
FLOW_PASSCODE_PARTNER=

# Optional display names
FLOW_MEMBER_TRISTAN_LABEL=Tristan
FLOW_MEMBER_PARTNER_LABEL=Jim Evans

# Required in production — Neon / hosted Postgres
# Leave empty locally to use in-memory PGlite
DATABASE_URL=

# Optional — pipeline machine import
FLOW_IMPORT_TOKEN=

# Optional — Google Drive sync (CSV snapshots; different folder than CIM packs)
FLOW_DRIVE_FOLDER_ID=0AIRHZYgxe1w-Uk9PVA
# CIM opener `/cim/TLY-XXX` lists Shared Drive 0ABYzLaaJ9ebAUk9PVA (read-only).
# Share that drive with the service account as Viewer. Same JSON key as CSV sync.
GOOGLE_SERVICE_ACCOUNT_JSON=
